<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kundenverwaltung.controller.statistiktool.GuthabenStatistikController" spacing="10" prefWidth="1200.0" > <!-- Größe angepasst -->

    <children>
        <VBox spacing="10"> <!-- Größe angepasst -->
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <MenuBar prefHeight="30.0" prefWidth="1200.0"> <!-- Größe angepasst -->
                <menus>
                    <Menu text="Datei">
                        <items>
                            <MenuItem onAction="#handleExit" text="Programm beenden" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            <Separator prefHeight="2.0" prefWidth="1190.0" />
			<!-- <fx:include source="statistiktool/StatistiktoolHeader.fxml" /> -->
			<HBox fx:id="childHeaderContainer" />
           <Separator prefHeight="2.0" prefWidth="1190.0" />
		</VBox>
		<VBox>
              <!-- Verteilstelle und Typ Auswahl -->
            <HBox spacing="20" alignment="CENTER">
                <Label text="Verteilstelle:"/>
                <ComboBox fx:id="verteilstelleComboBox" promptText="Verteilstelle auswählen" prefWidth="200">
                </ComboBox>

                <Label text="Typ:"/>
                <ComboBox fx:id="typeComboBox" promptText="Typ auswählen" prefWidth="250">
   
                </ComboBox>
                <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" />
            </padding>
            </HBox>
            
            <Separator prefHeight="2.0" prefWidth="1190.0" />
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

		</VBox>	
 		<VBox fx:id="childResultContainer" prefHeight="800.0" prefWidth="1000.0"/>
 			<!-- <fx:include source="statistiktool/StatistiktoolResultView.fxml" /> -->		
 
        
    </children>
</VBox>