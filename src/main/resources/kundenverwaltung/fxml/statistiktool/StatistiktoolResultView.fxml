<VBox fx:id="childResultContainer" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kundenverwaltung.controller.statistiktool.StatistiktoolResultViewController"> 
         <VBox fx:id="resultTableBox"  spacing="10.0" >
            <children>
              <TableView fx:id="queryResultTable"  />
            </children>
            <padding>
                 <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
         </VBox>
         <HBox prefHeight="67.0"  spacing="10.0">
            <children>
               <Button fx:id="executeQueryButton" mnemonicParsing="false" onAction="#loadStatistik" prefHeight="31.0" prefWidth="200.0" text="Abfrage ausführen" />
               <Button fx:id="executeCSVExportButton" mnemonicParsing="false" onAction="#exportCSVStatistik" prefHeight="31.0" prefWidth="200.0" text="CSV Export" />
               <Button fx:id="printButton" onAction="#handlePrint" prefHeight="31.0" prefWidth="200.0"  text="PDF Export" />
               <Button fx:id="openSQLQueryToolButton" onAction="#openSQLQueryTool" prefHeight="31.0" prefWidth="200.0" text="SQL-Abfrage Tool öffnen" />
            </children>
            <padding>
               <Insets left="10.0" />
            </padding>
         </HBox>
</VBox>
